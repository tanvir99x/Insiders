# Copy this file to .env.local and set values in the Vercel dashboard.
# Never commit real keys. If a key was ever committed, revoke it at the
# provider and create a new one before deploying.
NEYNAR_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=

# X OAuth 2.0. In the X Developer Portal, register this exact callback URL:
# https://YOUR_DOMAIN/api/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Supabase server connection. Use the Project URL and service_role key only in
# Vercel/server environments; never expose the service_role key in public JS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A long random value used to sign the HttpOnly wallet session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
